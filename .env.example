# Copy to .env (gitignored) and fill in. Never commit real values.
SEC_CONTACT_EMAIL=
GUARDIAN_API_KEY=
NYT_API_KEY=
# Telegram alerts: create a bot with @BotFather, put its token here, send the bot a message,
# then run `python -m stock_advisor.news.notify --setup` to fill in TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: most alerts sent per hour (default 10).
TELEGRAM_MAX_ALERTS_PER_HOUR=
