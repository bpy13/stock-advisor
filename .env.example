# Copy to .env (gitignored) and fill in. Never commit real values.
SEC_CONTACT_EMAIL=
GUARDIAN_API_KEY=
NYT_API_KEY=
# Telegram alerts: create a bot with @BotFather, put its token here, send the bot a message,
# then run `python -m stock_advisor.news.notify --setup` to fill in TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: most alerts sent per hour (default 10).
TELEGRAM_MAX_ALERTS_PER_HOUR=
# Alpaca free market-data keys (US bars): https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Claude Haiku news labels (news/label.py). Optional: monthly US$ ceiling for labelling (default 10).
ANTHROPIC_API_KEY=
LABEL_MONTHLY_CEILING_USD=
# Optional: path of research-inbox items.jsonl (default: ../research-inbox/data/shared/items.jsonl)
RESEARCH_INBOX_ITEMS=
